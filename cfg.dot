strict digraph {
B0 [label="B0\nint a = 0", shape=box];
B1 [label="B1\nx > 0", shape=box];
B2 [label="B2\na = 1", shape=box];
B3 [label=B3, shape=box];
B4 [label="B4\na = 2", shape=box];
B5 [label="B5\na < 5", shape=box];
B6 [label="B6\na = a + 1", shape=box];
B7 [label="B7\nreturn a;", shape=box];
B8 [label=B8, shape=box];
B0 -> B1 [label=fallthrough];
B1 -> B2 [label=true];
B1 -> B4 [label=false];
B2 -> B3 [label=fallthrough];
B3 -> B5 [label=fallthrough];
B4 -> B3 [label=fallthrough];
B5 -> B6 [label=true];
B5 -> B7 [label=false];
B6 -> B5 [label=back];
B7 -> B8 [label=fallthrough];
}
